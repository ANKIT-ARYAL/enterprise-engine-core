NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local Docker Engine Direct Connections
DATABASE_URL="postgresql://engine_user:engine_local_dev_password@localhost:5433/engine_dev_db?schema=public"
DIRECT_URL="postgresql://engine_user:engine_local_dev_password@localhost:5433/engine_dev_db?schema=public"

AUTH_SECRET="REPLACE_WITH_GENERATED_32_BYTE_HEX_SECRET"
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./public/uploads"

# Bootstrap superadmin login (create regular admins from the Users screen)
SUPERADMIN_EMAIL="super@admin.com"
SUPERADMIN_PASSWORD="superadmin123"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-admin-password"
AUDIT_LOG_RETENTION_DAYS="90"
