{
  "name": "create-enterprise-engine",
  "version": "0.1.0",
  "bin": {
    "create-enterprise-engine": "scripts/create-enterprise-engine.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup:project": "node scripts/setup-project.mjs",
    "prepare:env": "node scripts/prepare-env.mjs",
    "bootstrap:project": "node scripts/bootstrap-project.mjs",
    "generate:feature": "node scripts/generate-feature.mjs",
    "generate:mock-data": "node scripts/generate-mock-data.mjs",
    "load:mock-data": "node scripts/load-mock-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify-project.mjs",
    "vercel-build": "pnpm prisma generate && pnpm prisma migrate deploy && pnpm run verify && pnpm run build",
    "predeploy": "pnpm prisma generate && pnpm run verify && pnpm run build",
    "db:cleanup-audit": "tsx scripts/cleanup-audit-logs.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:clean": "docker compose -f docker/docker-compose.yml down -v"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.117.3",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@prisma/client": "5.13.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "5.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.14.0"
  ,"pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma", "sharp"]
  }
}
